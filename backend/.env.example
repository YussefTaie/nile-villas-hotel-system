# Nile Villas Hotel System - Environment Variables Reference
# Copy this file to .env and fill in real values.

PROJECT_NAME=Nile Villas System
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nile_villas_system
ECHO_SQL=False
SECRET_KEY=replace-with-a-strong-random-secret

